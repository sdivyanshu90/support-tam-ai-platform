# Copy to .env and fill in. .env is gitignored and must never be committed.
# At least one provider key is required; everything else has a working default.

# --- credentials -------------------------------------------------------------
# Set the key for whichever provider APP_MODEL points at. Both are free-tier.
#   Cerebras   https://cloud.cerebras.ai   ~1M tokens/day, 8K context, very fast
#   OpenRouter https://openrouter.ai       ~50 requests/day (20/min) on :free models
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# --- model -------------------------------------------------------------------
# Always "provider/model". Run `python -m app models` for the verified list.
#   cerebras/gpt-oss-120b                              fastest, strict json_schema
#   cerebras/gemma-4-31b                               smallest
#   cerebras/zai-glm-4.7                               reasoning model, json_object
#   openrouter/nvidia/nemotron-3-super-120b-a12b:free  large context, slower
APP_MODEL=cerebras/gpt-oss-120b
APP_MAX_TOKENS=4096
APP_LLM_TIMEOUT_S=120
APP_MAX_VALIDATION_RETRIES=2
APP_MAX_RATE_LIMIT_RETRIES=4

# Greedy decoding. Both providers accept these (unlike the Anthropic models this
# originally targeted, which reject `temperature` outright). Set APP_SEED=off to
# disable the seed.
APP_TEMPERATURE=0.0
APP_SEED=7

# --- determinism and cost ----------------------------------------------------
# Content-addressed cache of model responses. Keep on for reproducible demos.
APP_CACHE_ENABLED=true

# --- data --------------------------------------------------------------------
# The dataset is a historical snapshot (newest ticket 2026-05-22). Leave blank
# to anchor the 90-day window to the newest ticket; set an ISO-8601 timestamp
# to pin a different reference "today".
APP_AS_OF_DATE=
APP_ACCOUNT_WINDOW_DAYS=90
# Kept modest so the extraction prompt fits Cerebras' 8K free-tier context.
APP_MAX_TICKETS_PER_BRIEF=10
APP_MAX_TICKET_BODY_CHARS=700

# --- retrieval ---------------------------------------------------------------
APP_RETRIEVAL_TOP_K=5
APP_KNOWN_ISSUE_SCORE_FLOOR=0.18
APP_KNOWN_ISSUE_CONFIDENCE_FLOOR=0.55
APP_KB_CONTEXT_CHARS=4000

# --- observability -----------------------------------------------------------
APP_LOG_LEVEL=INFO
# Leave false. Ticket bodies may contain PII and must not reach logs.
APP_LOG_PAYLOADS=false
